# Local-only defaults. No AWS account or credentials are needed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
# Default remains HTTPS-required in production. See deployment/ec2.env.example.
ALLOW_INSECURE_HTTP=false
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/hub.sqlite
# Explicitly opt in only AFTER separate AWS authorization. Default is false.
ALLOW_AWS=false
# DynamoDB Local only: http://127.0.0.1:8000 (Compose uses http://dynamodb:8000)
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_TABLE=cloud-coordination-local
AWS_REGION=us-east-1
