{
  "name": "cloud-coordination-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch backend/src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsc -p backend/tsconfig.json",
    "start": "node dist/backend/backend/src/server.js",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "test": "vitest run",
    "test:dynamodb": "node scripts/local-dynamo-test.mjs",
    "test:e2e": "npm run build && node dist/backend/scripts/browser-smoke.js",
    "infra:validate": "node scripts/validate-infrastructure.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run infra:validate",
    "user:create": "tsx scripts/create-user.ts",
    "demo:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.3",
    "yaml": "^2.8.0"
  }
}
