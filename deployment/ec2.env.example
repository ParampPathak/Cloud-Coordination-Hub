NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Replace with the exact public address, with no path or trailing slash.
APP_ORIGIN=http://REPLACE_WITH_PUBLIC_IP
# Classroom HTTP only: use disposable accounts/data. Set false for HTTPS.
ALLOW_INSECURE_HTTP=true
DATABASE_DRIVER=sqlite
SQLITE_PATH=/var/lib/cloud-coordination-hub/hub.sqlite
ALLOW_AWS=false
